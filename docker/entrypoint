#!/usr/bin/env sh
set -eu

tmpdir="${TMPDIR:-/scratch/tmp}"
codex_home="${CODEX_HOME:-/scratch/codex-home}"
mkdir -p \
  "${HOME:-/scratch/home}" \
  "$tmpdir" \
  "$codex_home" \
  "${CANON_SANDBOX_DIR:-/scratch/sandbox}"

if [ -e /codex/auth.json ]; then
  for file in auth.json installation_id version.json; do
    [ ! -e "/codex/$file" ] || cp "/codex/$file" "$codex_home/$file"
  done
fi

system_skills_marker="/codex/skills/.system/.codex-system-skills.marker"
if [ -e "$system_skills_marker" ]; then
  mkdir -p "$codex_home/skills/.system"
  cp "$system_skills_marker" "$codex_home/skills/.system/.codex-system-skills.marker"
fi

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  host_index="$(git rev-parse --path-format=absolute --git-path index)"
  if [ -e "$host_index" ]; then
    # Copy only the host index. Do not set GIT_OBJECT_DIRECTORY or
    # GIT_ALTERNATE_OBJECT_DIRECTORIES; use the mounted repository object DB.
    export GIT_INDEX_FILE="$tmpdir/canon-git/index"
    mkdir -p "$(dirname "$GIT_INDEX_FILE")"
    cp "$host_index" "$GIT_INDEX_FILE"
  fi
fi

# Docker creates /scratch/secret for the bind mount before switching to
# --user, so Canon's chmod-based secret-dir isolation cannot manage it here.
# For canon check, Docker is the outer isolation boundary. --no-sandbox avoids
# Codex's nested OS sandbox launcher while Canon still materializes the filtered
# evaluator tree under /scratch/sandbox.
unset CANON_SECRET_DIR
if [ "${1:-}" = "check" ]; then
  shift
  # Preserve the user-supplied check arguments and insert Canon's container-only
  # sandbox mode before any selectors or `--` separator.
  set -- check --no-sandbox "$@"
fi
exec canon "$@"
