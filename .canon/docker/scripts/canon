#!/usr/bin/env bash
set -euo pipefail

image="${CANON_DOCKER_IMAGE:-ghcr.io/progbeat/canon:latest}"
project_root="$(git rev-parse --path-format=absolute --show-toplevel)"
[[ -t 0 && -t 1 ]] && tty=t || tty=

# Run Canon's Docker image with this repository root mounted inside the
# container. Command arguments are passed through unchanged.
#
# Host-side trust boundary:
# - the repository root, including `.git`, is mounted read/write so Canon can
#   update project files and use Git plumbing such as `git write-tree`;
# - the local Codex config is mounted read-only;
# - the container image filesystem is read-only, so other writable runtime files
#   live on /scratch tmpfs or explicit bind mounts.
#
# This wrapper assumes a normal Git repository checkout; Git worktrees are not
# currently supported.
exec docker run --rm "-i${tty}" \
  --user "$(id -u):$(id -g)" \
  --cap-drop=ALL \
  --security-opt=no-new-privileges \
  --read-only \
  --tmpfs "/scratch:mode=1777" \
  -v "${project_root}:/scratch/secret/repository:rw" \
  --mount "type=bind,src=${CODEX_HOME:-$HOME/.codex},dst=/codex,readonly" \
  "${image}" "$@"
